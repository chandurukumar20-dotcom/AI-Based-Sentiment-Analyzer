# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=sentiment_secret_key_change_in_production_2026
PORT=5000
DEBUG=True

# Database Configuration (MongoDB)
# For local MongoDB: mongodb://localhost:27017/
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/sentiment_db
MONGO_DB_NAME=sentiment_db
MONGO_TIMEOUT_MS=3000

# Model Configuration
# Primary: Hugging Face transformer model, Fallback: NLTK VADER
MODEL_NAME=cardiffnlp/twitter-roberta-base-sentiment-latest
USE_TRANSFORMERS=False
FALLBACK_TO_VADER=True

# File Upload Settings
MAX_CONTENT_LENGTH=16777216
UPLOAD_EXTENSIONS=.csv
